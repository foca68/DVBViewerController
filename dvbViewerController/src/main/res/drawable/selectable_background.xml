<?xml version="1.0" encoding="utf-8"?>
<!--
    Ripple supports ?attr/ from API 21+, so colorPrimary responds to theme switching.
    Checked state: a persistent colorPrimaryContainer fill behind the ripple.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorPrimary">

    <!-- Checked / selected state: persistent tinted background -->
    <item android:id="@android:id/background">
        <selector xmlns:customstate="http://schemas.android.com/apk/res-auto">
            <item android:drawable="@android:color/transparent"
                android:state_window_focused="false" />
            <item android:drawable="@color/disabled"
                android:state_enabled="false" />
            <item android:drawable="@color/color_selection_checked"
                customstate:state_checked="true" />
            <item android:drawable="@color/error"
                customstate:state_error="true" />
            <item android:drawable="@android:color/transparent" />
        </selector>
    </item>

    <!-- Ripple mask: full bounds -->
    <item android:id="@android:id/mask"
        android:drawable="@android:color/white" />

</ripple>
