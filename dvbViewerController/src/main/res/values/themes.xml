<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Light theme (blue default) — parent: Theme.Material3.Light.NoActionBar
        Used by the manifest for all activities.
    -->
    <style name="Theme.DVB" parent="Theme.Material3.Light.NoActionBar">

        <!-- Primary -->
        <item name="colorPrimary">@color/md_theme_light_primary</item>
        <item name="colorOnPrimary">@color/md_theme_light_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_light_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_light_onPrimaryContainer</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/md_theme_light_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_light_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_light_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_light_onSecondaryContainer</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>

        <!-- Error -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>

        <!-- Legacy compat (AppCompat components) -->
        <item name="colorAccent">@color/md_theme_light_secondary</item>
        <item name="colorPrimaryDark">@color/md_theme_light_primaryContainer</item>
        <item name="colorControlActivated">@color/md_theme_light_primary</item>
        <item name="colorControlNormal">@color/md_theme_light_onSurfaceVariant</item>

        <!-- Button shapes -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.App.Button.TextButton</item>

        <!-- App-specific -->
        <item name="actionModeBackground">@color/colorRecording</item>
        <item name="android:progressBarStyleHorizontal">@style/ProgressBarStyleHorizontal</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:windowSoftInputMode">stateHidden</item>

        <!-- Colored toolbar -->
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="appBarLayoutStyle">@style/Widget.App.AppBarLayout</item>

    </style>

    <style name="Theme.DVB.NoActionBar" parent="Theme.DVB">
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>
    </style>

    <!--
        Base for all color themes.

        IMPORTANT: extends Theme.Material3.Light.NoActionBar directly, NOT Theme.DVB.
        Reason: Activity.setTheme() calls applyStyle(resId, force=true) which processes
        the style hierarchy leaf→root. With force=true the ROOT (last processed) wins.
        If color themes inherited Theme.DVB, Theme.DVB's explicit colorPrimary=#1B5EAE
        would be applied AFTER the child's custom colorPrimary, overwriting it.
        By using Theme.Material3.Light.NoActionBar as the root (which does NOT set
        colorPrimary to a hardcoded app value), the child's colorPrimary survives.

        Contains all non-primary app attributes shared by every color theme.
    -->
    <style name="Theme.DVB.ColorsBase" parent="Theme.Material3.Light.NoActionBar">

        <!-- Tertiary — neutral, reused across all color themes -->
        <item name="colorTertiary">@color/md_theme_light_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_light_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_light_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_light_onTertiaryContainer</item>

        <!-- Error — same for all themes -->
        <item name="colorError">@color/md_theme_light_error</item>
        <item name="colorOnError">@color/md_theme_light_onError</item>
        <item name="colorErrorContainer">@color/md_theme_light_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_light_onErrorContainer</item>

        <!-- Background / Surface — neutral, same for all themes -->
        <item name="android:colorBackground">@color/md_theme_light_background</item>
        <item name="colorOnBackground">@color/md_theme_light_onBackground</item>
        <item name="colorSurface">@color/md_theme_light_surface</item>
        <item name="colorOnSurface">@color/md_theme_light_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_light_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_light_onSurfaceVariant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_light_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_light_outlineVariant</item>

        <!-- Non-primary legacy compat -->
        <item name="colorControlNormal">@color/md_theme_light_onSurfaceVariant</item>

        <!-- Button shapes -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.App.Button.TextButton</item>

        <!-- App-specific -->
        <item name="actionModeBackground">@color/colorRecording</item>
        <item name="android:progressBarStyleHorizontal">@style/ProgressBarStyleHorizontal</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:windowSoftInputMode">stateHidden</item>

        <!-- Colored toolbar — uses ?attr/colorPrimary set by each child theme -->
        <item name="toolbarStyle">@style/Widget.App.Toolbar</item>
        <item name="appBarLayoutStyle">@style/Widget.App.AppBarLayout</item>

        <!-- NoActionBar settings -->
        <item name="windowNoTitle">true</item>
        <item name="windowActionModeOverlay">true</item>

    </style>

    <!-- Blue — alias for the default blue theme -->
    <style name="Theme.DVB.Blue" parent="Theme.DVB.NoActionBar" />

    <!-- ── Color themes — extend ColorsBase (NOT Theme.DVB) ──────────────── -->

    <style name="Theme.DVB.Purple" parent="Theme.DVB.ColorsBase">
        <item name="colorPrimary">#7B1FA2</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#E1BEE7</item>
        <item name="colorOnPrimaryContainer">#4A148C</item>
        <item name="colorSecondary">#F57C00</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#FFE0B2</item>
        <item name="colorOnSecondaryContainer">#3E1A00</item>
        <item name="colorAccent">#7B1FA2</item>
        <item name="colorPrimaryDark">#E1BEE7</item>
        <item name="colorControlActivated">#7B1FA2</item>
        <item name="android:statusBarColor">#7B1FA2</item>
        <item name="android:navigationBarColor">@color/md_theme_light_background</item>
    </style>

    <style name="Theme.DVB.Green" parent="Theme.DVB.ColorsBase">
        <item name="colorPrimary">#1B5E20</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#C8E6C9</item>
        <item name="colorOnPrimaryContainer">#003300</item>
        <item name="colorSecondary">#1565C0</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#BBDEFB</item>
        <item name="colorOnSecondaryContainer">#001E5C</item>
        <item name="colorAccent">#1B5E20</item>
        <item name="colorPrimaryDark">#C8E6C9</item>
        <item name="colorControlActivated">#1B5E20</item>
        <item name="android:statusBarColor">#1B5E20</item>
        <item name="android:navigationBarColor">@color/md_theme_light_background</item>
    </style>

    <style name="Theme.DVB.Red" parent="Theme.DVB.ColorsBase">
        <item name="colorPrimary">#B71C1C</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFCDD2</item>
        <item name="colorOnPrimaryContainer">#370000</item>
        <item name="colorSecondary">#1565C0</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#BBDEFB</item>
        <item name="colorOnSecondaryContainer">#001E5C</item>
        <item name="colorAccent">#B71C1C</item>
        <item name="colorPrimaryDark">#FFCDD2</item>
        <item name="colorControlActivated">#B71C1C</item>
        <item name="android:statusBarColor">#B71C1C</item>
        <item name="android:navigationBarColor">@color/md_theme_light_background</item>
    </style>

    <style name="Theme.DVB.Orange" parent="Theme.DVB.ColorsBase">
        <item name="colorPrimary">#BF360C</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#FFCCBC</item>
        <item name="colorOnPrimaryContainer">#3E0000</item>
        <item name="colorSecondary">#1565C0</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#BBDEFB</item>
        <item name="colorOnSecondaryContainer">#001E5C</item>
        <item name="colorAccent">#BF360C</item>
        <item name="colorPrimaryDark">#FFCCBC</item>
        <item name="colorControlActivated">#BF360C</item>
        <item name="android:statusBarColor">#BF360C</item>
        <item name="android:navigationBarColor">@color/md_theme_light_background</item>
    </style>

    <style name="Theme.DVB.Gray" parent="Theme.DVB.ColorsBase">
        <item name="colorPrimary">#263238</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">#CFD8DC</item>
        <item name="colorOnPrimaryContainer">#0C1A1F</item>
        <item name="colorSecondary">#2E7D32</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSecondaryContainer">#C8E6C9</item>
        <item name="colorOnSecondaryContainer">#003300</item>
        <item name="colorAccent">#263238</item>
        <item name="colorPrimaryDark">#CFD8DC</item>
        <item name="colorControlActivated">#263238</item>
        <item name="android:statusBarColor">#263238</item>
        <item name="android:navigationBarColor">@color/md_theme_light_background</item>
    </style>

</resources>
