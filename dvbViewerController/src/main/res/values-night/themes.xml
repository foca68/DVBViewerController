<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        Dark theme — overrides Theme.DVB for night mode.
        Theme.DVB.NoActionBar inherits from Theme.DVB automatically.
    -->
    <style name="Theme.DVB" parent="Theme.Material3.Dark.NoActionBar">

        <!-- Primary -->
        <item name="colorPrimary">@color/md_theme_dark_primary</item>
        <item name="colorOnPrimary">@color/md_theme_dark_onPrimary</item>
        <item name="colorPrimaryContainer">@color/md_theme_dark_primaryContainer</item>
        <item name="colorOnPrimaryContainer">@color/md_theme_dark_onPrimaryContainer</item>

        <!-- Secondary -->
        <item name="colorSecondary">@color/md_theme_dark_secondary</item>
        <item name="colorOnSecondary">@color/md_theme_dark_onSecondary</item>
        <item name="colorSecondaryContainer">@color/md_theme_dark_secondaryContainer</item>
        <item name="colorOnSecondaryContainer">@color/md_theme_dark_onSecondaryContainer</item>

        <!-- Tertiary -->
        <item name="colorTertiary">@color/md_theme_dark_tertiary</item>
        <item name="colorOnTertiary">@color/md_theme_dark_onTertiary</item>
        <item name="colorTertiaryContainer">@color/md_theme_dark_tertiaryContainer</item>
        <item name="colorOnTertiaryContainer">@color/md_theme_dark_onTertiaryContainer</item>

        <!-- Error -->
        <item name="colorError">@color/md_theme_dark_error</item>
        <item name="colorOnError">@color/md_theme_dark_onError</item>
        <item name="colorErrorContainer">@color/md_theme_dark_errorContainer</item>
        <item name="colorOnErrorContainer">@color/md_theme_dark_onErrorContainer</item>

        <!-- Background / Surface -->
        <item name="android:colorBackground">@color/md_theme_dark_background</item>
        <item name="colorOnBackground">@color/md_theme_dark_onBackground</item>
        <item name="colorSurface">@color/md_theme_dark_surface</item>
        <item name="colorOnSurface">@color/md_theme_dark_onSurface</item>
        <item name="colorSurfaceVariant">@color/md_theme_dark_surfaceVariant</item>
        <item name="colorOnSurfaceVariant">@color/md_theme_dark_onSurfaceVariant</item>

        <!-- Outline -->
        <item name="colorOutline">@color/md_theme_dark_outline</item>
        <item name="colorOutlineVariant">@color/md_theme_dark_outlineVariant</item>

        <!-- Legacy compat attributes -->
        <item name="colorAccent">@color/md_theme_dark_secondary</item>
        <item name="colorPrimaryDark">@color/md_theme_dark_primaryContainer</item>
        <item name="colorControlActivated">@color/md_theme_dark_primary</item>
        <item name="colorControlNormal">@color/md_theme_dark_onSurfaceVariant</item>

        <!-- Button shapes -->
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
        <item name="android:buttonBarButtonStyle">@style/Widget.App.Button.TextButton</item>

        <!-- App-specific -->
        <item name="actionModeBackground">@color/colorRecording</item>
        <item name="android:progressBarStyleHorizontal">@style/ProgressBarStyleHorizontal</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
        <item name="android:windowSoftInputMode">stateHidden</item>

    </style>

    <!-- ── Color themes dark variants ─────────────────────────────────────
         Parent Theme.DVB.NoActionBar chains to night Theme.DVB automatically.    -->

    <style name="Theme.DVB.Blue" parent="Theme.DVB.NoActionBar" />

    <style name="Theme.DVB.Purple" parent="Theme.DVB.NoActionBar">
        <item name="colorPrimary">#CE93D8</item>
        <item name="colorOnPrimary">#38005A</item>
        <item name="colorPrimaryContainer">#6A1B9A</item>
        <item name="colorOnPrimaryContainer">#F3E5F5</item>
        <item name="colorSecondary">#FF9E80</item>
        <item name="colorOnSecondary">#4D1600</item>
        <item name="colorSecondaryContainer">#7C3010</item>
        <item name="colorOnSecondaryContainer">#FFCCBC</item>
        <item name="colorAccent">#CE93D8</item>
        <item name="colorPrimaryDark">#6A1B9A</item>
        <item name="colorControlActivated">#CE93D8</item>
    </style>

    <style name="Theme.DVB.Green" parent="Theme.DVB.NoActionBar">
        <item name="colorPrimary">#A5D6A7</item>
        <item name="colorOnPrimary">#003310</item>
        <item name="colorPrimaryContainer">#1B5E20</item>
        <item name="colorOnPrimaryContainer">#C8E6C9</item>
        <item name="colorSecondary">#90CAF9</item>
        <item name="colorOnSecondary">#00204A</item>
        <item name="colorSecondaryContainer">#1565C0</item>
        <item name="colorOnSecondaryContainer">#BBDEFB</item>
        <item name="colorAccent">#A5D6A7</item>
        <item name="colorPrimaryDark">#1B5E20</item>
        <item name="colorControlActivated">#A5D6A7</item>
    </style>

    <style name="Theme.DVB.Red" parent="Theme.DVB.NoActionBar">
        <item name="colorPrimary">#EF9A9A</item>
        <item name="colorOnPrimary">#4E0000</item>
        <item name="colorPrimaryContainer">#B71C1C</item>
        <item name="colorOnPrimaryContainer">#FFCDD2</item>
        <item name="colorSecondary">#90CAF9</item>
        <item name="colorOnSecondary">#00204A</item>
        <item name="colorSecondaryContainer">#1565C0</item>
        <item name="colorOnSecondaryContainer">#BBDEFB</item>
        <item name="colorAccent">#EF9A9A</item>
        <item name="colorPrimaryDark">#B71C1C</item>
        <item name="colorControlActivated">#EF9A9A</item>
    </style>

    <style name="Theme.DVB.Orange" parent="Theme.DVB.NoActionBar">
        <item name="colorPrimary">#FFAB91</item>
        <item name="colorOnPrimary">#4E1500</item>
        <item name="colorPrimaryContainer">#BF360C</item>
        <item name="colorOnPrimaryContainer">#FFCCBC</item>
        <item name="colorSecondary">#90CAF9</item>
        <item name="colorOnSecondary">#00204A</item>
        <item name="colorSecondaryContainer">#1565C0</item>
        <item name="colorOnSecondaryContainer">#BBDEFB</item>
        <item name="colorAccent">#FFAB91</item>
        <item name="colorPrimaryDark">#BF360C</item>
        <item name="colorControlActivated">#FFAB91</item>
    </style>

    <style name="Theme.DVB.Gray" parent="Theme.DVB.NoActionBar">
        <item name="colorPrimary">#B0BEC5</item>
        <item name="colorOnPrimary">#1A2529</item>
        <item name="colorPrimaryContainer">#263238</item>
        <item name="colorOnPrimaryContainer">#CFD8DC</item>
        <item name="colorSecondary">#A5D6A7</item>
        <item name="colorOnSecondary">#003310</item>
        <item name="colorSecondaryContainer">#2E7D32</item>
        <item name="colorOnSecondaryContainer">#C8E6C9</item>
        <item name="colorAccent">#B0BEC5</item>
        <item name="colorPrimaryDark">#263238</item>
        <item name="colorControlActivated">#B0BEC5</item>
    </style>

</resources>
